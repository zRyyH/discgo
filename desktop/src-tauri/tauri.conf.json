{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiscGo",
  "version": "0.1.0",
  "identifier": "app.discgo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiscGo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0B0C10",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/discgo-engine"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/gst/bin/*": "./",
      "resources/gst/plugins/*": "resources/gst/plugins/"
    },
    "publisher": "DiscGo",
    "shortDescription": "DiscGo",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "discgo"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQzE0NUUwRDQ4RUNBQzQKUldURXlvN1U0RVhCVGNxeWZuRnA0em4zYU9lTHhQL242enJ4L0VLV1JtRko1T2JET1pYTk15MTYK",
      "endpoints": [
        "https://discgo-releases.s3.sa-east-1.amazonaws.com/releases/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
