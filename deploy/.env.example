# API configuration (environment variables). Values below are for development and
# match deploy/docker-compose.dev.yml; `make api` loads this file as deploy/.env.dev.
# Production: copy to deploy/.env and replace every value.

HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://discgo:discgo@localhost:5432/discgo?sslmode=disable
# Public base URL of the API; the Google redirect URI is PUBLIC_URL/v1/auth/google/callback.
PUBLIC_URL=http://localhost:8080
COMMUNITY_NAME=DiscGo

# Google OAuth client (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser is sent after login; the app registers this scheme.
AUTH_REDIRECT=discgo://auth
SESSION_TTL=720h
# Login without Google via POST /v1/auth/dev. Development only.
AUTH_DEV=true

LIVEKIT_URL=ws://127.0.0.1:17880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-0123456789abcdef0123456789

P2P_MAX_PARTICIPANTS=2
P2P_SWITCH_DELAY=10s
P2P_BLOCK_TTL=1h
STUN_URLS=stun:stun.l.google.com:19302

# Attachments. Dev uses SeaweedFS on :9000 (any credentials); production uses AWS S3.
S3_REGION=sa-east-1
S3_BUCKET=discgo-attachments
S3_ENDPOINT=http://localhost:9000
S3_CREATE_BUCKET=true
MAX_UPLOAD_MB=25
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev

# Forced desktop updates (PLAN fase 9A): the updater manifest the API watches; apps older
# than its version are told to update over the gateway. Empty disables it.
RELEASES_URL=
RELEASES_POLL=60s

# --- production only (deploy/docker-compose.prod.yml) ---
# Base domain: the API is api.DOMAIN, LiveKit lk.DOMAIN, TURN turn.DOMAIN.
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
POSTGRES_PASSWORD=change-me
# Where nightly database dumps go (needs s3:PutObject).
BACKUP_S3_URI=s3://discgo-backups/db
BACKUP_AT=03:30
# In production also set: PUBLIC_URL=https://api.DOMAIN, LIVEKIT_URL=wss://lk.DOMAIN,
# STUN_URLS=stun:turn.DOMAIN:3478, S3_ENDPOINT= (empty), S3_CREATE_BUCKET=false, AUTH_DEV=false,
# RELEASES_URL=https://discgo-releases.s3.sa-east-1.amazonaws.com/releases/latest.json.
