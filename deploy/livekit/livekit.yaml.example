# LiveKit SFU (PLAN 9). Copy to livekit.yaml and replace DOMAIN and the key/secret
# (the secret must have at least 32 characters; same values as LIVEKIT_API_KEY /
# LIVEKIT_API_SECRET in deploy/.env).
port: 7880
bind_addresses:
  - 127.0.0.1 # signalling only through nginx (wss://lk.DOMAIN)

rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: true

keys:
  REPLACE_KEY: REPLACE_WITH_A_LONG_RANDOM_SECRET

# Built-in TURN: also answers STUN (STUN_URLS=stun:turn.DOMAIN:3478). Used only on
# the SFU path; P2P has no relay by design (PLAN 2.2).
turn:
  enabled: true
  domain: turn.DOMAIN
  udp_port: 3478
  tls_port: 5349
  cert_file: /etc/letsencrypt/live/api.DOMAIN/fullchain.pem
  key_file: /etc/letsencrypt/live/api.DOMAIN/privkey.pem

webhook:
  api_key: REPLACE_KEY
  urls:
    - http://127.0.0.1:8080/v1/livekit/webhook

room:
  empty_timeout: 60
  max_participants: 50

logging:
  level: info
