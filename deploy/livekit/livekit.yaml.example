# LiveKit SFU (PLAN 9, fase 10.4). Copy to livekit.yaml and replace DOMAIN and the keys
# (secrets of at least 32 characters). Production and the development API (PLAN fase
# 10.5) share this server, each with its own key pair: the first equals LIVEKIT_API_KEY /
# LIVEKIT_API_SECRET in /opt/discgo/deploy/.env, the second the same pair in
# /opt/discgo-dev/deploy/.env. Rooms are channel UUIDs, so the two never collide.
port: 7880
bind_addresses:
  - 127.0.0.1 # signalling only through nginx (wss://lk.DOMAIN)

rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: true

keys:
  REPLACE_PROD_KEY: REPLACE_WITH_A_LONG_RANDOM_SECRET
  REPLACE_DEV_KEY: REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Built-in TURN: also answers STUN (STUN_URLS=stun:turn.DOMAIN:3478). Used only on
# the SFU path; P2P has no relay by design (PLAN 2.2).
turn:
  enabled: true
  domain: turn.DOMAIN
  udp_port: 3478
  tls_port: 5349
  cert_file: /etc/letsencrypt/live/api.DOMAIN/fullchain.pem
  key_file: /etc/letsencrypt/live/api.DOMAIN/privkey.pem

# Production only: the development API does without the secondary leave confirmation.
webhook:
  api_key: REPLACE_PROD_KEY
  urls:
    - http://127.0.0.1:8080/v1/livekit/webhook

room:
  empty_timeout: 60
  max_participants: 50

logging:
  level: info
